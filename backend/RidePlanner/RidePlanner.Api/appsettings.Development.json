{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "RunMigrationsOnStartup": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Jwt": {
    "Secret": "super_secret_rideplanner_jwt_signing_key_at_least_32_bytes_long!",
    "Issuer": "RidePlanner",
    "Audience": "RidePlanner",
    "ExpiryMinutes": 15
  },
  "Identity": {
    "PasswordResetTokenLifespanHours": 2
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Register": {
      "PermitLimit": 3,
      "WindowSeconds": 60
    },
    "ForgotPassword": {
      "PermitLimit": 5,
      "WindowSeconds": 900
    },
    "ResetPassword": {
      "PermitLimit": 5,
      "WindowSeconds": 900
    },
    "ExternalLink": {
      "PermitLimit": 10,
      "WindowSeconds": 900
    }
  },
  "App": {
    "FrontendBaseUrl": "http://localhost:5173"
  }
}
